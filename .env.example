# API del worker de contenido (formulario de contacto).
# Vacío = /api/contact (proxy local a wrangler en :8787, o mismo origen en producción).
PUBLIC_CONTENT_API=

# Etiqueta de Google Analytics 4 (G-XXXXXXXX). Sin este valor no se envían visitas.
# En producción hay que definirla también en el entorno de build de Vercel.
PUBLIC_GA_MEASUREMENT_ID=

# Contenedor de Google Tag Manager (GTM-XXXXXXX).
# Si también hay ID de medición, no crees en Tag Manager otra etiqueta de GA4
# con el mismo ID: la visita ya se envía desde la web.
PUBLIC_GTM_ID=
