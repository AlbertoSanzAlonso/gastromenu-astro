---
import BrandDivider from '@/components/ui/BrandDivider.astro'
import Section from '@/components/ui/Section.astro'
import { company } from '@/data/contact'
import { getMessages } from '@/i18n'
import type { Locale } from '@/i18n/locale'

interface Props {
  locale?: Locale
  fadeTop?: boolean
}

const { locale = 'es', fadeTop = false } = Astro.props
const m = getMessages(locale)
const prefix = locale === 'en' ? '/en' : ''
---

<Section
  variant="beige"
  ariaLabel={m.home.ctaLabel}
  edgeFade={fadeTop ? 'top' : undefined}
>
  <div class="mx-auto max-w-3xl text-center">
    <BrandDivider class="mb-8" />
    <p class="slide-label mb-8">{m.home.ctaKicker}</p>
    <h2 class="slide-heading mb-8 text-balance text-3xl md:text-4xl">
      {m.home.ctaTitleBefore}{' '}
      <span class="slide-accent">{m.home.ctaTitleAccent}</span>?
    </h2>
    <p class="slide-body mx-auto mb-12 max-w-2xl">{m.home.ctaBody}</p>
    <a href={`${prefix}/contacto`} class="group inline-block cursor-pointer">
      <span
        class="inline-flex items-center justify-center border border-ink bg-ink px-10 py-4 font-label text-base font-medium uppercase tracking-[0.25em] text-cream transition-all duration-400 ease-premium hover:scale-[1.04] hover:border-gold-slide hover:bg-charcoal hover:text-cream hover:shadow-lg hover:shadow-gold-slide/30 group-hover:tracking-[0.3em] active:scale-[0.98]"
      >
        {m.home.ctaButton}
      </span>
    </a>
    <p class="slide-body mt-8">
      {m.contact.call}:{' '}
      <a
        href={`tel:${company.phones[0].tel}`}
        class="text-gold-dark transition-colors hover:text-gold-slide"
      >
        {company.phones[0].display}
      </a>
    </p>
    <p class="slide-accent mt-12 text-2xl md:text-3xl">{m.footer.motto}</p>
  </div>
</Section>
