---
import { getMessages } from '@/i18n'
import { analyticsEnabled } from '@/lib/analytics/google'
import type { Locale } from '@/i18n/locale'

interface Props {
  locale?: Locale
}

const { locale = 'es' } = Astro.props
const m = getMessages(locale)
const privacyHref = `${locale === 'en' ? '/en' : ''}/privacidad#cookies`
const body = analyticsEnabled ? m.cookies.analyticsBody : m.cookies.body
const buttonClass =
  'inline-flex max-w-full items-center justify-center border px-8 py-3 font-label text-sm font-medium uppercase tracking-[0.25em] transition-all duration-400 ease-premium hover:scale-[1.04] active:scale-[0.98] md:max-w-none'
const acceptClass = `${buttonClass} border-ink bg-ink text-cream hover:border-gold-slide hover:bg-charcoal hover:shadow-lg hover:shadow-gold-slide/30`
const rejectClass = `${buttonClass} border-cream/35 bg-transparent text-cream hover:border-gold-slide hover:text-gold-highlight`
---

<aside
  id="cookie-notice"
  class="cookie-notice"
  data-shown="false"
  inert
  aria-hidden="true"
  role="region"
  aria-label={m.cookies.label}
>
  <div class="cookie-notice-art" aria-hidden>
    <img
      data-cookie-art
      alt=""
      width="640"
      height="960"
      decoding="async"
      fetchpriority="low"
      class="cookie-notice-watermark cookie-notice-watermark--soft"
    />
    <img
      data-cookie-art
      alt=""
      width="640"
      height="960"
      decoding="async"
      fetchpriority="low"
      class="cookie-notice-watermark"
    />
    <div class="cookie-notice-fade"></div>
  </div>
  <div
    class="container-premium cookie-notice-panel relative z-[2] flex flex-col gap-4 md:flex-row md:items-center md:justify-between"
  >
    <p class="slide-body max-w-3xl text-sm">
      {body}{' '}
      <a
        href={privacyHref}
        class="text-gold-slide underline underline-offset-4 transition-colors hover:text-gold-highlight"
      >
        {m.cookies.privacy}
      </a>.
    </p>
    {
      analyticsEnabled ? (
        <div class="flex w-full shrink-0 flex-col gap-3 sm:w-auto sm:flex-row">
          <button type="button" data-cookie-reject class:list={[rejectClass, 'w-full sm:w-auto']}>
            {m.cookies.reject}
          </button>
          <button type="button" data-cookie-accept class:list={[acceptClass, 'w-full sm:w-auto']}>
            {m.cookies.acceptAnalytics}
          </button>
        </div>
      ) : (
        <button type="button" data-cookie-technical class={acceptClass}>
          {m.cookies.accept}
        </button>
      )
    }
  </div>
</aside>

<script>
  import { COOKIE_NOTICE_ART_SRC } from '@/data/brand'
  import {
    analyticsEnabled,
    onCookieSettings,
    readConsent,
    trackPageView,
    writeConsent,
  } from '@/lib/analytics/google'

  const STORAGE_KEY = 'gastromenu.cookie-notice'
  const EXIT_MS = 800
  const notice = document.getElementById('cookie-notice')

  function shouldOpen() {
    if (analyticsEnabled) return readConsent() === null
    try {
      return localStorage.getItem(STORAGE_KEY) !== '1'
    } catch {
      return true
    }
  }

  function loadArt() {
    if (!notice) return
    notice.querySelectorAll('[data-cookie-art]').forEach((img) => {
      if (img instanceof HTMLImageElement && !img.getAttribute('src')) img.src = COOKIE_NOTICE_ART_SRC
    })
  }

  function open() {
    if (!notice) return
    loadArt()
    notice.removeAttribute('inert')
    notice.removeAttribute('aria-hidden')
    notice.removeAttribute('data-leaving')
    notice.setAttribute('data-shown', 'false')
    requestAnimationFrame(() => {
      requestAnimationFrame(() => notice.setAttribute('data-shown', 'true'))
    })
  }

  function close() {
    if (!notice) return
    notice.setAttribute('data-shown', 'false')
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      notice.setAttribute('inert', '')
      notice.setAttribute('aria-hidden', 'true')
      return
    }
    notice.setAttribute('data-leaving', 'true')
    window.setTimeout(() => {
      notice.setAttribute('inert', '')
      notice.setAttribute('aria-hidden', 'true')
      notice.removeAttribute('data-leaving')
    }, EXIT_MS)
  }

  if (notice) {
    if (shouldOpen()) open()

    notice.querySelector('[data-cookie-technical]')?.addEventListener('click', () => {
      try {
        localStorage.setItem(STORAGE_KEY, '1')
      } catch {
        /* ignore */
      }
      close()
    })

    notice.querySelector('[data-cookie-accept]')?.addEventListener('click', () => {
      writeConsent('granted')
      trackPageView(`${window.location.pathname}${window.location.search}`)
      close()
    })

    notice.querySelector('[data-cookie-reject]')?.addEventListener('click', () => {
      writeConsent('denied')
      close()
    })

    onCookieSettings(open)
    document.addEventListener('click', (event) => {
      const target = event.target
      if (!(target instanceof Element) || !target.closest('[data-cookie-settings]')) return
      open()
    })
  }
</script>
