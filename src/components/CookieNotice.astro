---
import { FOOTER_WATERMARK_SRC } from '@/data/brand'
import { getMessages } from '@/i18n'
import type { Locale } from '@/i18n/locale'

interface Props {
  locale?: Locale
}

const { locale = 'es' } = Astro.props
const m = getMessages(locale)
const privacyHref = `${locale === 'en' ? '/en' : ''}/privacidad#cookies`
---

<aside
  id="cookie-notice"
  class="cookie-notice"
  data-shown="false"
  hidden
  role="region"
  aria-label={m.cookies.label}
>
  <div class="cookie-notice-art" aria-hidden>
    <img
      data-cookie-art
      alt=""
      width="1024"
      height="1536"
      decoding="async"
      fetchpriority="low"
      class="cookie-notice-watermark cookie-notice-watermark--soft"
    />
    <img
      data-cookie-art
      alt=""
      width="1024"
      height="1536"
      decoding="async"
      fetchpriority="low"
      class="cookie-notice-watermark"
    />
    <div class="cookie-notice-fade"></div>
  </div>
  <div
    class="container-premium cookie-notice-panel relative z-[2] flex flex-col gap-4 md:flex-row md:items-center md:justify-between"
  >
    <p class="slide-body max-w-3xl text-sm">
      {m.cookies.body}{' '}
      <a
        href={privacyHref}
        class="text-gold-slide underline underline-offset-4 transition-colors hover:text-gold-highlight"
      >
        {m.cookies.privacy}
      </a>.
    </p>
    <button
      type="button"
      id="cookie-notice-accept"
      class="inline-flex max-w-full items-center justify-center border border-ink bg-ink px-8 py-3 font-label text-sm font-medium uppercase tracking-[0.25em] text-cream transition-all duration-400 ease-premium hover:scale-[1.04] hover:border-gold-slide hover:bg-charcoal hover:shadow-lg hover:shadow-gold-slide/30 active:scale-[0.98] md:max-w-none"
    >
      {m.cookies.accept}
    </button>
  </div>
</aside>

<script define:vars={{ watermarkSrc: FOOTER_WATERMARK_SRC }}>
  const STORAGE_KEY = 'gastromenu.cookie-notice'
  const notice = document.getElementById('cookie-notice')
  const accept = document.getElementById('cookie-notice-accept')
  if (notice && accept) {
    let stored = false
    try {
      stored = localStorage.getItem(STORAGE_KEY) === '1'
    } catch {
      stored = false
    }
    if (!stored) {
      notice.querySelectorAll('[data-cookie-art]').forEach((img) => {
        if (img instanceof HTMLImageElement) img.src = watermarkSrc
      })
      notice.hidden = false
      requestAnimationFrame(() => {
        requestAnimationFrame(() => notice.setAttribute('data-shown', 'true'))
      })
    }
    accept.addEventListener('click', () => {
      try {
        localStorage.setItem(STORAGE_KEY, '1')
      } catch {
        /* ignore */
      }
      notice.setAttribute('data-leaving', 'true')
      notice.setAttribute('data-shown', 'false')
      window.setTimeout(() => {
        notice.hidden = true
      }, 800)
    })
  }
</script>
