---
import ContactCTA from '@/components/ContactCTA.astro'
import BrandDivider from '@/components/ui/BrandDivider.astro'
import type { DossierPageContent } from '@/data/dossierTypes'
import { dossierImageUrl } from '@/data/dossierTypes'
import type { Locale } from '@/i18n/locale'
import Layout from '@/layouts/Layout.astro'

interface Props {
  content: DossierPageContent
  locale?: Locale
}

const { content, locale = 'es' } = Astro.props
const hero = content.heroImages?.[0]
---

<Layout
  title={content.seoTitle}
  description={content.seoDescription}
  path={content.path}
  locale={locale}
>
  <section class="bg-ink text-cream">
    <div class="container-premium py-12 md:py-16">
      <p class="slide-label mb-6">{content.kicker}</p>
      <h1 class="slide-heading max-w-4xl text-4xl text-cream md:text-6xl">
        {content.title}
        {content.emphasis && <span class="slide-accent"> {content.emphasis}</span>}
      </h1>
      <BrandDivider class="!mx-0 mt-8 mb-6 max-w-[8rem]" />
      <p class="slide-body max-w-3xl text-lg text-cream-muted md:text-xl">{content.lead}</p>
      {
        hero && (
          <div class="mt-10 overflow-hidden">
            <img
              src={dossierImageUrl(hero)}
              alt={hero.caption}
              class="aspect-[16/9] w-full max-w-4xl object-cover"
              loading="eager"
              decoding="async"
            />
          </div>
        )
      }
    </div>
  </section>

  {
    content.sections.map((section) => {
      const image = section.images[0]
      const dark = section.variant === 'dark'
      return (
        <section
          id={section.id}
          class:list={[
            'section-padding relative overflow-hidden border-t border-white/5',
            dark
              ? 'bg-ink text-cream [&_.slide-heading]:text-cream [&_.slide-body]:text-cream-muted'
              : section.variant === 'beige'
                ? 'bg-beige-100/65 text-ink [&_.slide-heading]:text-ink [&_.slide-body]:text-stone'
                : 'bg-beige-50/65 text-ink [&_.slide-heading]:text-ink [&_.slide-body]:text-stone',
          ]}
        >
          <div class="container-premium relative z-[2] grid gap-10 lg:grid-cols-2 lg:items-start">
            <div>
              <p class="slide-label mb-4">{section.kicker}</p>
              <h2 class="slide-heading mb-6 text-3xl md:text-4xl">
                {section.title}
                {section.emphasis && <span class="slide-accent"> {section.emphasis}</span>}
              </h2>
              <div class="space-y-4">
                {section.paragraphs.map((paragraph) => (
                  <p class="slide-body text-base md:text-lg">{paragraph}</p>
                ))}
              </div>
              {section.highlights && section.highlights.length > 0 && (
                <ul class="mt-8 space-y-2">
                  {section.highlights.map((item) => (
                    <li class="font-label text-sm tracking-wide text-gold-slide">— {item}</li>
                  ))}
                </ul>
              )}
            </div>
            {image && (
              <div class="overflow-hidden bg-ink-muted">
                <img
                  src={dossierImageUrl(image)}
                  alt={image.caption}
                  class="aspect-[4/3] w-full object-cover transition-transform duration-700 ease-premium hover:scale-[1.02]"
                  loading="lazy"
                  decoding="async"
                />
              </div>
            )}
          </div>
        </section>
      )
    })
  }

  <ContactCTA locale={locale} fadeTop />
</Layout>
