---
import type { DossierPageContent } from '@/data/dossierTypes'
import { dossierImageUrl } from '@/data/dossierTypes'
import Layout from '@/layouts/Layout.astro'

interface Props {
  content: DossierPageContent
}

const { content } = Astro.props
const hero = content.heroImages?.[0]
---

<Layout title={content.seoTitle} description={content.seoDescription} path={content.path}>
  <section class="bg-ink text-cream">
    <div class="container-x py-12 md:py-16">
      <p class="slide-label mb-6">{content.kicker}</p>
      <h1 class="slide-heading max-w-4xl text-4xl text-cream md:text-6xl">
        {content.title}
        {content.emphasis && <span class="gold-text"> {content.emphasis}</span>}
      </h1>
      <div class="brand-divider !mx-0 mt-8 mb-6 max-w-[8rem]"></div>
      <p class="slide-body max-w-3xl text-lg md:text-xl">{content.lead}</p>
      {
        hero && (
          <div class="mt-10 overflow-hidden">
            <img
              src={dossierImageUrl(hero)}
              alt={hero.caption}
              class="aspect-[16/9] w-full max-w-4xl object-cover"
              loading="eager"
              decoding="async"
            />
          </div>
        )
      }
    </div>
  </section>

  {
    content.sections.map((section) => {
      const image = section.images[0]
      const dark = section.variant === 'dark'
      return (
        <section
          id={section.id}
          class:list={[
            'border-t border-white/5 py-14 md:py-20',
            dark ? 'bg-ink text-cream' : 'bg-beige-50 text-ink',
          ]}
        >
          <div class="container-x grid gap-10 lg:grid-cols-2 lg:items-start">
            <div>
              <p class:list={['slide-label mb-4', !dark && 'text-gold-dark']}>{section.kicker}</p>
              <h2
                class:list={[
                  'slide-heading mb-6 text-3xl md:text-4xl',
                  dark ? 'text-cream' : 'text-ink',
                ]}
              >
                {section.title}
                {section.emphasis && <span class="gold-text"> {section.emphasis}</span>}
              </h2>
              <div class="space-y-4">
                {section.paragraphs.map((paragraph) => (
                  <p
                    class:list={[
                      'slide-body text-base md:text-lg',
                      dark ? 'text-cream-muted' : 'text-slate',
                    ]}
                  >
                    {paragraph}
                  </p>
                ))}
              </div>
              {section.highlights && section.highlights.length > 0 && (
                <ul class="mt-8 space-y-2">
                  {section.highlights.map((item) => (
                    <li
                      class:list={[
                        'font-[family-name:var(--font-label)] text-sm tracking-wide',
                        dark ? 'text-gold-slide' : 'text-gold-dark',
                      ]}
                    >
                      — {item}
                    </li>
                  ))}
                </ul>
              )}
            </div>
            {image && (
              <div class="overflow-hidden bg-ink-muted">
                <img
                  src={dossierImageUrl(image)}
                  alt={image.caption}
                  class="aspect-[4/3] w-full object-cover"
                  loading="lazy"
                  decoding="async"
                />
              </div>
            )}
          </div>
        </section>
      )
    })
  }
</Layout>
