---
import { BRAND_ICON_SRC } from '@/data/brand'
import { getMessages } from '@/i18n'
import { localePath, type Locale } from '@/i18n/locale'

interface Props {
  locale?: Locale
  path?: string
}

const { locale = 'es', path = '/' } = Astro.props
const m = getMessages(locale)
const prefix = locale === 'en' ? '/en' : ''
---

<header class="site-header fixed inset-x-0 top-0 z-50" data-scrolled="false" id="site-header">
  <div class="container-premium flex h-20 items-center justify-center md:h-24">
    <a
      href={prefix || '/'}
      class="z-10 flex items-center gap-2 group sm:gap-3 md:gap-4"
      aria-label={m.nav.home}
    >
      <img
        src={BRAND_ICON_SRC}
        alt=""
        aria-hidden="true"
        width="44"
        height="44"
        class="h-8 w-8 object-contain sm:h-9 sm:w-9 md:h-11 md:w-11"
        data-header-logo
        decoding="async"
      />
      <span
        class="brand-title text-center text-[clamp(0.66rem,3.15vw,0.84rem)] leading-[1.15] tracking-[0.14em] text-gold-slide transition-all duration-500 ease-premium group-hover:opacity-80 sm:text-left sm:text-xs sm:leading-none md:text-sm"
        data-header-title
        aria-hidden="true"
      >
        <span class="block whitespace-nowrap sm:inline">GastroMenu</span>
        <span class="hidden sm:inline"> </span>
        <span class="block whitespace-nowrap sm:inline">Premium</span>
      </span>
    </a>
  </div>
</header>

<div
  class="fixed top-5 left-5 z-[70] flex items-center gap-2 p-2.5 transition-opacity duration-300 ease-premium md:top-7 md:left-10"
  role="group"
  aria-label={m.language.label}
  data-header-langs
>
  <a
    href={localePath('es', path)}
    lang="es"
    hreflang="es"
    aria-label={m.language.es}
    aria-current={locale === 'es' ? 'true' : undefined}
    class:list={[
      'relative block transition-opacity duration-400 ease-premium',
      locale === 'es' ? 'opacity-100 after:absolute after:inset-x-0 after:-bottom-1.5 after:h-px after:bg-gold-slide' : 'opacity-55 hover:opacity-80',
    ]}
  >
    <svg viewBox="0 0 30 20" aria-hidden="true" focusable="false" class="lang-flag block h-3.5 w-[1.3rem]">
      <rect width="30" height="20" fill="#7a3b22"></rect>
      <rect y="5" width="30" height="10" fill="#e2c48a"></rect>
    </svg>
  </a>
  <span aria-hidden="true" class="h-3.5 w-px bg-cream/35"></span>
  <a
    href={localePath('en', path)}
    lang="en"
    hreflang="en"
    aria-label={m.language.en}
    aria-current={locale === 'en' ? 'true' : undefined}
    class:list={[
      'relative block transition-opacity duration-400 ease-premium',
      locale === 'en' ? 'opacity-100 after:absolute after:inset-x-0 after:-bottom-1.5 after:h-px after:bg-gold-slide' : 'opacity-55 hover:opacity-80',
    ]}
  >
    <svg viewBox="0 0 30 20" aria-hidden="true" focusable="false" class="lang-flag block h-3.5 w-[1.3rem]">
      <rect width="30" height="20" fill="#012169"></rect>
      <path d="M0 0 L30 20 M30 0 L0 20" stroke="#fff" stroke-width="4"></path>
      <path d="M0 0 L30 20 M30 0 L0 20" stroke="#C8102E" stroke-width="2"></path>
      <path d="M15 0 V20 M0 10 H30" stroke="#fff" stroke-width="6"></path>
      <path d="M15 0 V20 M0 10 H30" stroke="#C8102E" stroke-width="3"></path>
    </svg>
  </a>
</div>

<button
  type="button"
  id="nav-toggle"
  class="nav-toggle fixed top-5 right-5 z-[70] cursor-pointer p-2.5 text-gold-slide transition-colors duration-500 ease-premium hover:opacity-80 sm:right-8 md:top-7 md:right-10"
  data-open="false"
  aria-expanded="false"
  aria-controls="site-menu"
  aria-label={m.nav.open}
>
  <span class="nav-toggle__bars" aria-hidden="true">
    <span class="nav-toggle__bar nav-toggle__bar--top"><span></span></span>
    <span class="nav-toggle__bar nav-toggle__bar--mid"></span>
    <span class="nav-toggle__bar nav-toggle__bar--bot"><span></span></span>
  </span>
</button>

<div class="site-drawer-root" data-open="false" id="site-drawer-root" inert>
  <div class="site-drawer-backdrop" id="site-drawer-backdrop"></div>
  <nav id="site-menu" class="site-drawer" aria-label={m.nav.primary}>
    <div class="site-drawer-sheet">
      <div class="site-drawer-head">
        <a href={prefix || '/'} class="site-drawer-brand" aria-label={m.nav.home}>
          <img
            src={BRAND_ICON_SRC}
            alt=""
            aria-hidden="true"
            width="48"
            height="48"
            class="h-8 w-8 object-contain sm:h-9 sm:w-9 md:h-12 md:w-12"
            decoding="async"
          />
          <span class="brand-title text-xs tracking-[0.14em] text-gold-dark sm:text-sm" aria-hidden="true"
            >GastroMenu Premium</span
          >
        </a>
      </div>
      <ul>
        {
          m.nav.links.map((link, index) => (
            <li class="site-drawer-link" style={`transition-delay: ${520 + index * 48}ms`}>
              <a
                href={`${prefix}${link.to}`}
                class:list={['site-drawer-anchor', path === link.to && 'is-active']}
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
      <div class="site-drawer-foot">
        <a href={`${prefix}/contacto#formulario`} class="site-drawer-cta">{m.nav.contact}</a>
        <p class="site-drawer-note">{m.nav.note}</p>
      </div>
    </div>
    <div class="site-drawer-shade" aria-hidden></div>
  </nav>
</div>

<script define:vars={{ openLabel: m.nav.open, closeLabel: m.nav.close }}>
  const header = document.getElementById('site-header')
  const logo = document.querySelector('[data-header-logo]')
  const title = document.querySelector('[data-header-title]')
  const langs = document.querySelector('[data-header-langs]')
  const toggle = document.getElementById('nav-toggle')
  const drawer = document.getElementById('site-drawer-root')
  const backdrop = document.getElementById('site-drawer-backdrop')
  if (!header || !toggle || !drawer) throw new Error('header missing')

  const DRAWER_CLOSE_MS = 900
  let open = false
  let langsVisible = true
  let navigating = false

  function setScrolled(scrolled) {
    header.setAttribute('data-scrolled', scrolled ? 'true' : 'false')
    if (logo) logo.classList.toggle('brightness-0', scrolled)
    if (logo) logo.classList.toggle('invert', scrolled)
    if (title) {
      title.classList.toggle('text-white', scrolled)
      title.classList.toggle('text-gold-slide', !scrolled)
    }
    if (!open) {
      toggle.classList.toggle('text-white', scrolled)
      toggle.classList.toggle('text-gold-slide', !scrolled)
    }
  }

  function onScroll() {
    setScrolled(window.scrollY > 12)
  }
  onScroll()
  window.addEventListener('scroll', onScroll, { passive: true })

  function setOpen(next) {
    open = next
    drawer.setAttribute('data-open', open ? 'true' : 'false')
    toggle.setAttribute('data-open', open ? 'true' : 'false')
    toggle.setAttribute('aria-expanded', open ? 'true' : 'false')
    toggle.setAttribute('aria-label', open ? closeLabel : openLabel)
    toggle.classList.toggle('text-ink', open)
    if (open) {
      toggle.classList.remove('text-white', 'text-gold-slide')
      document.body.style.overflow = 'hidden'
      drawer.removeAttribute('inert')
      if (langs) {
        langsVisible = false
        langs.classList.add('max-md:pointer-events-none', 'max-md:opacity-0')
      }
    } else {
      document.body.style.overflow = ''
      drawer.setAttribute('inert', '')
      setScrolled(window.scrollY > 12)
      window.setTimeout(() => {
        if (langs && !open) {
          langsVisible = true
          langs.classList.remove('max-md:pointer-events-none', 'max-md:opacity-0')
        }
      }, DRAWER_CLOSE_MS)
    }
  }

  function shouldDelayNavigation(event, link) {
    if (event.defaultPrevented) return false
    if (event.button !== 0) return false
    if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return false
    if (link.target && link.target !== '_self') return false
    const href = link.getAttribute('href')
    if (!href || href.startsWith('mailto:') || href.startsWith('tel:')) return false
    const url = new URL(href, window.location.href)
    if (url.origin !== window.location.origin) return false
    const sameDocument =
      url.pathname === window.location.pathname && url.search === window.location.search
    if (sameDocument) return false
    return true
  }

  toggle.addEventListener('click', () => setOpen(!open))
  backdrop?.addEventListener('click', () => setOpen(false))
  drawer.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', (event) => {
      if (!open || navigating) return
      if (!shouldDelayNavigation(event, link)) {
        setOpen(false)
        return
      }
      event.preventDefault()
      navigating = true
      const href = link.href
      setOpen(false)
      window.setTimeout(() => {
        window.location.assign(href)
      }, DRAWER_CLOSE_MS)
    })
  })
  window.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && open) setOpen(false)
  })
</script>
