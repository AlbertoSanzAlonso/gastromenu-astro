---
import { getMessages } from '@/i18n'
import { localePath, type Locale } from '@/i18n/locale'

interface Props {
  locale?: Locale
  path?: string
}

const { locale = 'es', path = '/' } = Astro.props
const m = getMessages(locale)
const prefix = locale === 'en' ? '/en' : ''
---

<header class="fixed inset-x-0 top-0 z-50 border-b border-white/5 bg-ink/80 backdrop-blur-md">
  <div class="container-x flex h-20 items-center justify-between md:h-24">
    <a
      href={prefix || '/'}
      class="flex items-center gap-3 group"
      aria-label={m.nav.home}
    >
      <img
        src="/logo-mark.svg"
        alt=""
        width="44"
        height="44"
        class="h-9 w-9 object-contain md:h-11 md:w-11"
      />
      <span class="brand-title text-xs text-gold-slide group-hover:opacity-80 md:text-sm">
        <span class="block sm:inline">GastroMenu</span>
        <span class="hidden sm:inline"> </span>
        <span class="block sm:inline">Premium</span>
      </span>
    </a>

    <nav class="hidden items-center gap-6 lg:flex" aria-label={m.nav.primary}>
      {
        m.nav.links.map((link) => (
          <a
            href={`${prefix}${link.to}`}
            class="font-[family-name:var(--font-label)] text-[11px] uppercase tracking-[0.18em] text-cream/80 hover:text-gold-slide"
          >
            {link.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-3">
      <div class="flex items-center gap-1 font-[family-name:var(--font-label)] text-[10px] uppercase tracking-[0.16em]" aria-label={m.language.label}>
        <a
          href={localePath('es', path)}
          class:list={['px-1.5 py-1', locale === 'es' ? 'text-gold-slide' : 'text-cream/50 hover:text-gold-slide']}
          hreflang="es"
          lang="es"
        >
          ES
        </a>
        <span class="text-cream/30" aria-hidden>/</span>
        <a
          href={localePath('en', path)}
          class:list={['px-1.5 py-1', locale === 'en' ? 'text-gold-slide' : 'text-cream/50 hover:text-gold-slide']}
          hreflang="en"
          lang="en"
        >
          EN
        </a>
      </div>

      <details class="relative lg:hidden">
        <summary
          class="cursor-pointer list-none p-2 font-[family-name:var(--font-label)] text-[11px] uppercase tracking-[0.18em] text-gold-slide"
        >
          {locale === 'en' ? 'Menu' : 'Menú'}
        </summary>
        <div
          class="absolute right-0 mt-3 w-56 rounded-sm border border-gold-slide/20 bg-ink-soft p-4 shadow-xl"
        >
          <ul class="space-y-3">
            {
              m.nav.links.map((link) => (
                <li>
                  <a
                    href={`${prefix}${link.to}`}
                    class="block font-[family-name:var(--font-label)] text-xs uppercase tracking-[0.16em] text-cream hover:text-gold-slide"
                  >
                    {link.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      </details>
    </div>
  </div>
</header>
