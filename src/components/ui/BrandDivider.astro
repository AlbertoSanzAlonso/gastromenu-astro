---
interface Props {
  class?: string
}
const { class: className = '' } = Astro.props
---

<div class:list={['mx-auto flex w-full max-w-xs items-center gap-3', className]} aria-hidden>
  <span class="h-px flex-1 bg-gold-slide/40"></span>
  <span class="h-1.5 w-1.5 rotate-45 bg-gold-slide/70"></span>
  <span class="h-px flex-1 bg-gold-slide/40"></span>
</div>
