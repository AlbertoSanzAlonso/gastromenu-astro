---
import BrandDivider from '@/components/ui/BrandDivider.astro'

interface Props {
  as?: 'h1' | 'h2' | 'h3' | 'h4'
  subtitle?: string
  align?: 'left' | 'center'
  class?: string
}

const { as: Tag = 'h2', subtitle, align = 'left', class: className = '' } = Astro.props
const sizeStyles = {
  h1: 'text-4xl md:text-5xl lg:text-6xl',
  h2: 'text-3xl md:text-4xl lg:text-5xl',
  h3: 'text-2xl md:text-3xl',
  h4: 'text-xl md:text-2xl',
}
const alignClass = align === 'center' ? 'mx-auto text-center' : ''
---

<header class:list={['mb-16 max-w-4xl md:mb-20', alignClass, className]}>
  <Tag class:list={['slide-heading text-balance', sizeStyles[Tag]]}>
    <slot />
  </Tag>
  {
    subtitle && (
      <>
        <BrandDivider class:list={['mt-8 mb-6', align !== 'center' && '!mx-0']} />
        <p class="slide-label">{subtitle}</p>
      </>
    )
  }
</header>
