---
import '../styles/global.css'
import CookieNotice from '@/components/CookieNotice.astro'
import FloatingActions from '@/components/FloatingActions.astro'
import Footer from '@/components/Footer.astro'
import Header from '@/components/Header.astro'
import Seo from '@/components/Seo.astro'
import { BRAND_ICON_SRC } from '@/data/brand'
import type { Locale } from '@/i18n/locale'

interface Props {
  title: string
  description: string
  path?: string
  image?: string
  type?: 'website' | 'article'
  noindex?: boolean
  locale?: Locale
}

const { locale = 'es', path = '/', ...seo } = Astro.props
const isHome = path === '/' || path === '/en'
const fontsHref =
  'https://fonts.googleapis.com/css2?family=Cinzel:wght@400;600&family=Montserrat:wght@400;500&family=Pinyon+Script&family=Playfair+Display:ital,wght@0,300;0,400;0,500;1,400&display=swap'
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#0a0a0a" />
    <link rel="icon" type="image/svg+xml" href="/logo-mark.svg" />
    <link rel="apple-touch-icon" href="/icono_gm_sin_fondo.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" type="application/xml" title="Sitemap" href="/sitemap.xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preload" as="style" href={fontsHref} />
    <link href={fontsHref} rel="stylesheet" media="print" onload="this.media='all'" />
    <noscript>
      <link href={fontsHref} rel="stylesheet" />
    </noscript>
    {
      isHome && (
        <link
          rel="preload"
          as="image"
          href="/images/hero-ref-01-800.webp"
          imagesrcset="/images/hero-ref-01-800.webp 800w, /images/hero-ref-01.webp 1254w"
          imagesizes="100vw"
          fetchpriority="high"
        />
      )
    }
    <meta name="generator" content={Astro.generator} />
    <Seo {...seo} path={path} locale={locale} />
  </head>
  <body class="min-h-screen">
    <div class="flex min-h-screen flex-col">
      <div aria-hidden class="brand-watermark">
        <img src={BRAND_ICON_SRC} alt="" decoding="async" />
      </div>
      <Header locale={locale} path={path} />
      <main class="relative z-10 flex-1 pt-20 md:pt-24">
        <slot />
      </main>
      <Footer locale={locale} />
      <CookieNotice locale={locale} />
      <FloatingActions locale={locale} />
    </div>
  </body>
</html>
