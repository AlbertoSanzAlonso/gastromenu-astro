---
import { Font } from 'astro:assets'
import '../styles/global.css'
import Analytics from '@/components/Analytics.astro'
import CookieNotice from '@/components/CookieNotice.astro'
import FloatingActions from '@/components/FloatingActions.astro'
import Footer from '@/components/Footer.astro'
import Header from '@/components/Header.astro'
import Seo from '@/components/Seo.astro'
import { BRAND_ICON_SRC } from '@/data/brand'
import type { Locale } from '@/i18n/locale'

interface Props {
  title: string
  description: string
  path?: string
  image?: string
  type?: 'website' | 'article'
  noindex?: boolean
  locale?: Locale
}

const { locale = 'es', path = '/', ...seo } = Astro.props
const isHome = path === '/' || path === '/en'
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#0a0a0a" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/png" href="/icon-192.png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" type="application/xml" title="Sitemap" href="/sitemap.xml" />
    {/* Precarga tipografías del primer viewport para reducir CLS al swap */}
    <Font cssVariable="--font-cinzel" preload />
    <Font cssVariable="--font-playfair" preload />
    <Font cssVariable="--font-montserrat" />
    <Font cssVariable="--font-pinyon" />
    {
      isHome && (
        <link
          rel="preload"
          as="image"
          href="/images/hero-mark.png"
          media="(min-width: 1024px)"
          fetchpriority="high"
        />
        <link
          rel="preload"
          as="image"
          href="/images/hero-ref-01-640.webp"
          imagesrcset="/images/hero-ref-01-640.webp 640w, /images/hero-ref-01.webp 800w"
          imagesizes="100vw"
          media="(max-width: 1023px)"
          fetchpriority="high"
        />
      )
    }
    <meta name="generator" content={Astro.generator} />
    <Seo {...seo} path={path} locale={locale} />
    <Analytics part="head" />
  </head>
  <body class="min-h-screen">
    <Analytics part="body" />
    <div class="flex min-h-screen flex-col">
      <div aria-hidden class="brand-watermark">
        <img
          src={BRAND_ICON_SRC}
          alt=""
          width="341"
          height="539"
          decoding="async"
          fetchpriority="low"
        />
      </div>
      <Header locale={locale} path={path} />
      <main class="relative z-10 flex-1 pt-20 md:pt-24">
        <slot />
      </main>
      <Footer locale={locale} />
      <CookieNotice locale={locale} />
      <FloatingActions locale={locale} />
    </div>
  </body>
</html>
