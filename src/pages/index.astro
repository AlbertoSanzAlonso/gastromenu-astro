---
import Layout from '@/layouts/Layout.astro'
import { collections } from '@/lib/nav'
import { homeSeo } from '@/lib/seo/site'
---

<Layout title={homeSeo.title} description={homeSeo.description} path="/">
  <section class="relative min-h-[88vh] overflow-hidden">
    <img
      src="/images/hero/01-the-view.webp"
      alt="Carta artesanal GastroMenu Premium"
      class="absolute inset-0 h-full w-full object-cover"
      loading="eager"
      decoding="async"
    />
    <div class="absolute inset-0 bg-gradient-to-r from-ink via-ink/75 to-ink/30"></div>
    <div class="container-x relative z-10 flex min-h-[88vh] flex-col justify-end pb-16 pt-28 md:pb-24">
      <p class="slide-label mb-5">Fabricación propia desde 1998</p>
      <h1 class="brand-title mb-4 max-w-3xl text-3xl text-cream md:text-5xl md:leading-tight">
        GastroMenu Premium
      </h1>
      <p class="slide-heading mb-6 max-w-2xl text-2xl text-cream md:text-4xl">
        Cartas artesanales <span class="gold-text">para el alma</span> de tu negocio
      </p>
      <p class="slide-body mb-10 max-w-xl text-lg">
        Cartas, atriles y manteles con fabricación propia. Presentación que forma parte de la
        experiencia.
      </p>
      <div class="flex flex-wrap gap-4">
        <a
          href="/cartas"
          class="inline-flex items-center bg-gold-slide px-6 py-3 font-[family-name:var(--font-label)] text-[11px] uppercase tracking-[0.2em] text-ink hover:bg-gold-highlight"
        >
          Descubrir colección
        </a>
        <a
          href="/contacto"
          class="inline-flex items-center border border-cream/40 px-6 py-3 font-[family-name:var(--font-label)] text-[11px] uppercase tracking-[0.2em] text-cream hover:border-gold-slide hover:text-gold-slide"
        >
          Contactar
        </a>
      </div>
    </div>
  </section>

  <section class="bg-beige-50 py-16 text-ink md:py-24" aria-label="Colecciones">
    <div class="container-x">
      <p class="slide-label mb-4 text-gold-dark">Colecciones</p>
      <h2 class="slide-heading mb-10 max-w-2xl text-3xl md:text-5xl">
        Piezas para la mesa y la sala
      </h2>
      <div class="grid gap-6 sm:grid-cols-2">
        {
          collections.map((item) => (
            <a href={item.href} class="group block overflow-hidden bg-ink">
              <div class="aspect-[16/10] overflow-hidden">
                <img
                  src={item.image}
                  alt={item.label}
                  class="h-full w-full object-cover transition-transform duration-700 ease-[var(--ease-premium)] group-hover:scale-[1.04]"
                  loading="lazy"
                  decoding="async"
                />
              </div>
              <div class="flex items-center justify-between px-5 py-4">
                <span class="brand-title text-xs text-gold-slide">{item.label}</span>
                <span class="font-[family-name:var(--font-label)] text-[10px] uppercase tracking-[0.18em] text-cream/60 group-hover:text-gold-slide">
                  Ver
                </span>
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="bg-ink py-16 md:py-24">
    <div class="container-x max-w-3xl text-center">
      <p class="slide-label mb-4">Desde 1998</p>
      <h2 class="slide-heading mb-6 text-3xl text-cream md:text-5xl">
        Más de 28 años convirtiendo la presentación en experiencia
      </h2>
      <div class="brand-divider mb-6"></div>
      <p class="slide-body mb-10 text-lg">
        Talleres propios, materiales nobles y acabados pensados para el uso diario de la sala.
      </p>
      <a
        href="/nosotros"
        class="inline-flex border border-gold-slide/50 px-6 py-3 font-[family-name:var(--font-label)] text-[11px] uppercase tracking-[0.2em] text-gold-slide hover:bg-gold-slide hover:text-ink"
      >
        Conocer GastroMenu
      </a>
    </div>
  </section>
</Layout>
